<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#A52A2A"
        android:padding="10dp"
        android:text="@string/tytul"
        android:textColor="@android:color/white"
        android:textSize="26sp" />

    <Button
        android:id="@+id/przyciskRzuc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#D2691E"
        android:text="@string/rzuc_koscmi"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@android:color/white"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/kostka1"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            android:contentDescription="@string/kostka"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

        <ImageView
            android:id="@+id/kostka2"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            android:contentDescription="@string/kostka"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

        <ImageView
            android:id="@+id/kostka3"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            android:contentDescription="@string/kostka"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

        <ImageView
            android:id="@+id/kostka4"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            android:contentDescription="@string/kostka"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

        <ImageView
            android:id="@+id/kostka5"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            android:contentDescription="@string/kostka"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

    </LinearLayout>

    <TextView
        android:id="@+id/wynikLosowania"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/wynik_losowania_poczatek"
        android:textColor="#5A4A3A"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/wynikGry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/wynik_gry_poczatek"
        android:textColor="#5A4A3A"
        android:textSize="18sp" />

    <Button
        android:id="@+id/przyciskResetuj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#D2691E"
        android:text="@string/resetuj_wynik"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

</LinearLayout>
